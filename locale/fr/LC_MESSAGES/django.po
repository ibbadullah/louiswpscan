# ----- Scanner categories -----
#: .\publicapp\scanner.py:245
msgid "Transport security"
msgstr "Sécurité du transport"

# ----- Scanner findings (titles) -----
#: .\publicapp\scanner.py:250 .\publicapp\scanner.py:255
#: .\publicapp\scanner.py:266
msgid "HTTPS encryption"
msgstr "Chiffrement HTTPS"

#: .\publicapp\scanner.py:251
msgid "The site is served over HTTPS and enforces it with HSTS."
msgstr "Le site est servi en HTTPS et l'impose avec HSTS."

#: .\publicapp\scanner.py:256
msgid ""
"The site uses HTTPS but does not send a Strict-Transport-Security header, so"
" a first visit can still be downgraded to plain HTTP."
msgstr ""
"Le site utilise HTTPS mais n'envoie pas d'en-tête Strict-Transport-Security,"
" de sorte qu'une première visite peut encore être rétrogradée vers du HTTP "
"non chiffré."

#: .\publicapp\scanner.py:259
msgid ""
"Add the header: Strict-Transport-Security: max-age=31536000; "
"includeSubDomains"
msgstr ""
"Ajoutez l'en-tête : Strict-Transport-Security: max-age=31536000; "
"includeSubDomains"

#: .\publicapp\scanner.py:260
msgid ""
"On shared hosting you can add this in your .htaccess file inside an "
"<IfModule mod_headers.c> block."
msgstr ""
"Sur un hébergement mutualisé, vous pouvez l'ajouter dans votre fichier "
".htaccess à l'intérieur d'un bloc <IfModule mod_headers.c>."

#: .\publicapp\scanner.py:262
msgid ""
"Make sure every page redirects from http:// to https:// permanently (301)."
msgstr ""
"Assurez-vous que chaque page redirige de http:// vers https:// de façon "
"permanente (301)."

#: .\publicapp\scanner.py:267
msgid ""
"The site does not enforce HTTPS. Visitor data and login passwords can be "
"read on the network."
msgstr ""
"Le site n'impose pas le HTTPS. Les données des visiteurs et les mots de "
"passe de connexion peuvent être lus sur le réseau."

#: .\publicapp\scanner.py:269
msgid ""
"Install a free SSL certificate. Most shared hosts offer Let's Encrypt with "
"one click in cPanel."
msgstr ""
"Installez un certificat SSL gratuit. La plupart des hébergeurs mutualisés "
"proposent Let's Encrypt en un clic dans cPanel."

#: .\publicapp\scanner.py:270
msgid "Force HTTPS by adding a redirect rule in your .htaccess file."
msgstr ""
"Forcez le HTTPS en ajoutant une règle de redirection dans votre fichier "
".htaccess."

#: .\publicapp\scanner.py:271
msgid ""
"In WordPress set both the WordPress Address and Site Address to the https://"
" version."
msgstr ""
"Dans WordPress, définissez l'adresse WordPress et l'adresse du site sur la "
"version https://."

#: .\publicapp\scanner.py:277
msgid "Browser hardening"
msgstr "Renforcement du navigateur"

#: .\publicapp\scanner.py:279
msgid "clickjacking protection"
msgstr "protection contre le détournement de clic"

#: .\publicapp\scanner.py:280
msgid "MIME sniffing protection"
msgstr "protection contre le reniflage MIME"

#: .\publicapp\scanner.py:281
msgid "content security policy"
msgstr "politique de sécurité du contenu"

#: .\publicapp\scanner.py:282
msgid "referrer policy"
msgstr "politique de référent"

#: .\publicapp\scanner.py:287 .\publicapp\scanner.py:292
msgid "Security response headers"
msgstr "En-têtes de réponse de sécurité"

#: .\publicapp\scanner.py:288
msgid "All of the recommended browser security headers are present."
msgstr ""
"Tous les en-têtes de sécurité recommandés pour le navigateur sont présents."

#: .\publicapp\scanner.py:293
#, python-format
msgid "The following protective headers are missing: %(list)s."
msgstr "Les en-têtes de protection suivants sont manquants : %(list)s."

#: .\publicapp\scanner.py:295
msgid "Add the missing headers in your .htaccess file using mod_headers."
msgstr ""
"Ajoutez les en-têtes manquants dans votre fichier .htaccess à l'aide de "
"mod_headers."

#: .\publicapp\scanner.py:296
msgid ""
"Recommended values: X-Frame-Options: SAMEORIGIN, X-Content-Type-Options: "
"nosniff, Referrer-Policy: strict-origin-when-cross-origin."
msgstr ""
"Valeurs recommandées : X-Frame-Options: SAMEORIGIN, X-Content-Type-Options: "
"nosniff, Referrer-Policy: strict-origin-when-cross-origin."

#: .\publicapp\scanner.py:298
msgid ""
"A security plugin such as a headers manager can also set these without "
"editing files."
msgstr ""
"Une extension de sécurité de type gestionnaire d'en-têtes peut aussi les "
"définir sans modifier de fichiers."

#: .\publicapp\scanner.py:304
msgid "DDoS and firewall"
msgstr "DDoS et pare-feu"

#: .\publicapp\scanner.py:315 .\publicapp\scanner.py:320
msgid "DDoS protection and web firewall"
msgstr "Protection anti-DDoS et pare-feu applicatif"

#: .\publicapp\scanner.py:316
msgid ""
"The site appears to sit behind a content delivery network or web application"
" firewall, which absorbs traffic floods and filters bad requests."
msgstr ""
"Le site semble se trouver derrière un réseau de diffusion de contenu ou un "
"pare-feu applicatif web, qui absorbe les afflux de trafic et filtre les "
"requêtes malveillantes."

#: .\publicapp\scanner.py:321
msgid ""
"No content delivery network or web application firewall was detected. On "
"shared hosting a traffic flood can take the site offline and there is no "
"filtering layer in front of WordPress."
msgstr ""
"Aucun réseau de diffusion de contenu ni pare-feu applicatif web n'a été "
"détecté. Sur un hébergement mutualisé, un afflux de trafic peut mettre le "
"site hors ligne et aucune couche de filtrage ne protège WordPress."

#: .\publicapp\scanner.py:325
msgid ""
"Put the site behind a free plan of a content delivery network such as "
"Cloudflare. It is free and works on shared hosting by only changing your "
"DNS."
msgstr ""
"Placez le site derrière l'offre gratuite d'un réseau de diffusion de contenu"
" tel que Cloudflare. C'est gratuit et cela fonctionne sur un hébergement "
"mutualisé en modifiant seulement votre DNS."

#: .\publicapp\scanner.py:327
msgid "Enable the firewall and bot fight features once the DNS is proxied."
msgstr ""
"Activez le pare-feu et les fonctions de lutte contre les robots une fois le "
"DNS mis en proxy."

#: .\publicapp\scanner.py:328
msgid "Turn on rate limiting for the login and XML-RPC endpoints."
msgstr ""
"Activez la limitation du débit pour les points d'accès de connexion et XML-"
"RPC."

#: .\publicapp\scanner.py:334 .\publicapp\scanner.py:494
#: .\publicapp\scanner.py:518 .\publicapp\scanner.py:538
msgid "Information disclosure"
msgstr "Divulgation d'informations"

#: .\publicapp\scanner.py:342
msgid "an unknown version"
msgstr "une version inconnue"

#: .\publicapp\scanner.py:344 .\publicapp\scanner.py:354
msgid "WordPress version disclosure"
msgstr "Divulgation de la version de WordPress"

#: .\publicapp\scanner.py:345
#, python-format
msgid ""
"The site reveals its WordPress version (%(v)s). Attackers use the version "
"number to look up matching exploits."
msgstr ""
"Le site révèle sa version de WordPress (%(v)s). Les attaquants utilisent le "
"numéro de version pour rechercher les exploits correspondants."

#: .\publicapp\scanner.py:348
msgid ""
"Remove the version meta tag. Many security plugins do this automatically."
msgstr ""
"Supprimez la balise meta de version. De nombreuses extensions de sécurité le"
" font automatiquement."

#: .\publicapp\scanner.py:349
msgid "Delete or block public access to readme.html and license.txt."
msgstr "Supprimez ou bloquez l'accès public à readme.html et license.txt."

#: .\publicapp\scanner.py:350
msgid ""
"Most important of all: keep WordPress, themes and plugins fully up to date."
msgstr ""
"Le plus important de tout : maintenez WordPress, les thèmes et les "
"extensions entièrement à jour."

#: .\publicapp\scanner.py:355
msgid "The WordPress version is not openly advertised."
msgstr "La version de WordPress n'est pas affichée ouvertement."

#: .\publicapp\scanner.py:360
msgid "Brute force and DDoS"
msgstr "Force brute et DDoS"

#: .\publicapp\scanner.py:368
msgid "XML-RPC interface enabled"
msgstr "Interface XML-RPC activée"

#: .\publicapp\scanner.py:369
msgid ""
"xmlrpc.php is active. This single file lets an attacker try hundreds of "
"passwords in one request (system.multicall) and can be abused to attack "
"other websites (pingback flooding)."
msgstr ""
"xmlrpc.php est actif. Ce simple fichier permet à un attaquant d'essayer des "
"centaines de mots de passe en une seule requête (system.multicall) et peut "
"être détourné pour attaquer d'autres sites (inondation par pingback)."

#: .\publicapp\scanner.py:373
msgid ""
"If you do not use the Jetpack or the mobile app, disable XML-RPC completely "
"with a security plugin or by blocking the file in .htaccess."
msgstr ""
"Si vous n'utilisez ni Jetpack ni l'application mobile, désactivez "
"complètement XML-RPC avec une extension de sécurité ou en bloquant le "
"fichier dans .htaccess."

#: .\publicapp\scanner.py:375
msgid "To block it, deny access to xmlrpc.php in your .htaccess file."
msgstr ""
"Pour le bloquer, refusez l'accès à xmlrpc.php dans votre fichier .htaccess."

#: .\publicapp\scanner.py:376
msgid ""
"If you need it, at least disable pingbacks and add login rate limiting."
msgstr ""
"Si vous en avez besoin, désactivez au moins les pingbacks et ajoutez une "
"limitation du débit de connexion."

#: .\publicapp\scanner.py:380
msgid "XML-RPC interface"
msgstr "Interface XML-RPC"

#: .\publicapp\scanner.py:381
msgid "The XML-RPC interface is disabled or blocked."
msgstr "L'interface XML-RPC est désactivée ou bloquée."

#: .\publicapp\scanner.py:386 .\publicapp\scanner.py:446
msgid "Brute force protection"
msgstr "Protection contre la force brute"

#: .\publicapp\scanner.py:394
msgid "Login page openly reachable"
msgstr "Page de connexion librement accessible"

#: .\publicapp\scanner.py:395
msgid ""
"The default login page wp-login.php is reachable by anyone with no extra "
"protection in front of it. This is the main door attackers knock on to guess"
" passwords."
msgstr ""
"La page de connexion par défaut wp-login.php est accessible à tous sans "
"protection supplémentaire devant elle. C'est la porte principale à laquelle "
"frappent les attaquants pour deviner les mots de passe."

#: .\publicapp\scanner.py:399
msgid ""
"Install a login security plugin that limits failed attempts and locks out "
"repeat offenders."
msgstr ""
"Installez une extension de sécurité de connexion qui limite les tentatives "
"échouées et bloque les récidivistes."

#: .\publicapp\scanner.py:401
msgid "Enable two factor authentication for every administrator account."
msgstr ""
"Activez l'authentification à deux facteurs pour chaque compte "
"administrateur."

#: .\publicapp\scanner.py:402
msgid ""
"Protect the login page with a server password (HTTP basic auth) through "
"cPanel directory privacy, or change the login URL."
msgstr ""
"Protégez la page de connexion avec un mot de passe serveur (authentification"
" HTTP basique) via la confidentialité des répertoires de cPanel, ou modifiez"
" l'URL de connexion."

#: .\publicapp\scanner.py:404
msgid "Never use the username admin and always use a long unique password."
msgstr ""
"N'utilisez jamais le nom d'utilisateur admin et utilisez toujours un mot de "
"passe long et unique."

#: .\publicapp\scanner.py:408
msgid "Login page protection"
msgstr "Protection de la page de connexion"

#: .\publicapp\scanner.py:409
msgid "The default login page is not openly reachable or is protected."
msgstr ""
"La page de connexion par défaut n'est pas librement accessible ou est "
"protégée."

#: .\publicapp\scanner.py:414
msgid "Default URLs"
msgstr "URL par défaut"

#: .\publicapp\scanner.py:419 .\publicapp\scanner.py:440
msgid "Default admin URL"
msgstr "URL d'administration par défaut"

#: .\publicapp\scanner.py:420
msgid "The default admin area did not respond."
msgstr "La zone d'administration par défaut n'a pas répondu."

#: .\publicapp\scanner.py:428
msgid "Default admin URL reachable"
msgstr "URL d'administration par défaut accessible"

#: .\publicapp\scanner.py:429
msgid ""
"The default WordPress admin address /wp-admin/ is reachable. Attackers know "
"this address by heart and point their password guessing tools straight at "
"it."
msgstr ""
"L'adresse d'administration par défaut de WordPress /wp-admin/ est "
"accessible. Les attaquants connaissent cette adresse par cœur et y dirigent "
"directement leurs outils de devinette de mots de passe."

#: .\publicapp\scanner.py:432
msgid ""
"Protect the wp-admin folder with an extra server password using cPanel "
"directory privacy."
msgstr ""
"Protégez le dossier wp-admin avec un mot de passe serveur supplémentaire via"
" la confidentialité des répertoires de cPanel."

#: .\publicapp\scanner.py:433
msgid ""
"If you always connect from the same place, allow only your own IP address to"
" reach /wp-admin/ in your .htaccess file."
msgstr ""
"Si vous vous connectez toujours depuis le même endroit, autorisez uniquement"
" votre propre adresse IP à accéder à /wp-admin/ dans votre fichier "
".htaccess."

#: .\publicapp\scanner.py:435
msgid ""
"Use a security plugin to change the login and admin address to something "
"only you know."
msgstr ""
"Utilisez une extension de sécurité pour remplacer l'adresse de connexion et "
"d'administration par une adresse connue de vous seul."

#: .\publicapp\scanner.py:436
msgid ""
"Always pair this with two factor authentication and a login attempt limiter."
msgstr ""
"Associez toujours cela à l'authentification à deux facteurs et à un limiteur"
" de tentatives de connexion."

#: .\publicapp\scanner.py:441
msgid "The default admin address is not openly reachable."
msgstr "L'adresse d'administration par défaut n'est pas librement accessible."

#: .\publicapp\scanner.py:476
msgid "Default or common admin username"
msgstr "Nom d'administrateur par défaut ou courant"

#: .\publicapp\scanner.py:477
#, python-format
msgid ""
"The site uses a well known username (%(list)s). Half of a brute force attack"
" is already solved when the username is easy to guess."
msgstr ""
"Le site utilise un nom d'utilisateur bien connu (%(list)s). La moitié d'une "
"attaque par force brute est déjà résolue lorsque le nom d'utilisateur est "
"facile à deviner."

#: .\publicapp\scanner.py:480
msgid ""
"Create a brand new administrator account with a unique username that is not "
"a real word."
msgstr ""
"Créez un tout nouveau compte administrateur avec un nom d'utilisateur unique"
" qui n'est pas un vrai mot."

#: .\publicapp\scanner.py:481
msgid ""
"Log in with the new account, then delete the old default account and "
"reassign its content to the new one."
msgstr ""
"Connectez-vous avec le nouveau compte, puis supprimez l'ancien compte par "
"défaut et réattribuez son contenu au nouveau."

#: .\publicapp\scanner.py:483
msgid "Never use admin, administrator or your domain name as a login name."
msgstr ""
"N'utilisez jamais admin, administrator ou le nom de votre domaine comme nom "
"de connexion."

#: .\publicapp\scanner.py:484
msgid ""
"Add two factor authentication and a plugin that limits failed login "
"attempts."
msgstr ""
"Ajoutez l'authentification à deux facteurs et une extension qui limite les "
"tentatives de connexion échouées."

#: .\publicapp\scanner.py:488
msgid "Default username check"
msgstr "Vérification des noms d'utilisateur par défaut"

#: .\publicapp\scanner.py:489
msgid "No common default usernames were visible from public data."
msgstr ""
"Aucun nom d'utilisateur par défaut courant n'était visible dans les données "
"publiques."

#: .\publicapp\scanner.py:501
msgid "Username enumeration possible"
msgstr "Énumération des identifiants possible"

#: .\publicapp\scanner.py:502
msgid ""
"The list of author usernames can be read through the REST API or the author "
"page redirect. Knowing real usernames makes password guessing much easier."
msgstr ""
"La liste des noms d'utilisateur des auteurs peut être lue via l'API REST ou "
"la redirection de la page auteur. Connaître les vrais noms d'utilisateur "
"rend la devinette des mots de passe bien plus facile."

#: .\publicapp\scanner.py:505
msgid ""
"Block the wp-json/wp/v2/users endpoint for visitors who are not logged in. "
"Many security plugins offer a single switch for this."
msgstr ""
"Bloquez le point d'accès wp-json/wp/v2/users pour les visiteurs non "
"connectés. De nombreuses extensions de sécurité proposent une simple option "
"pour cela."

#: .\publicapp\scanner.py:507
msgid "Stop the ?author= redirect so it no longer reveals the login name."
msgstr ""
"Empêchez la redirection ?author= afin qu'elle ne révèle plus le nom de "
"connexion."

#: .\publicapp\scanner.py:508
msgid "Use display names that are different from the login names."
msgstr "Utilisez des noms d'affichage différents des noms de connexion."

#: .\publicapp\scanner.py:512
msgid "Username enumeration"
msgstr "Énumération des identifiants"

#: .\publicapp\scanner.py:513
msgid "Author usernames are not exposed through the common channels."
msgstr ""
"Les noms d'utilisateur des auteurs ne sont pas exposés par les canaux "
"courants."

#: .\publicapp\scanner.py:523
msgid "Directory listing enabled"
msgstr "Listage des répertoires activé"

#: .\publicapp\scanner.py:524
msgid ""
"The uploads folder shows a public file index. Visitors can browse every "
"uploaded file, including files you did not link anywhere."
msgstr ""
"Le dossier des téléversements affiche un index public des fichiers. Les "
"visiteurs peuvent parcourir chaque fichier téléversé, y compris ceux que "
"vous n'avez liés nulle part."

#: .\publicapp\scanner.py:527
msgid ""
"Disable directory browsing by adding Options -Indexes to your .htaccess "
"file."
msgstr ""
"Désactivez la navigation dans les répertoires en ajoutant Options -Indexes à"
" votre fichier .htaccess."

#: .\publicapp\scanner.py:528
msgid ""
"Place an empty index.html file inside folders that should not be browsed."
msgstr ""
"Placez un fichier index.html vide dans les dossiers qui ne doivent pas être "
"parcourus."

#: .\publicapp\scanner.py:532
msgid "Directory listing"
msgstr "Listage des répertoires"

#: .\publicapp\scanner.py:533
msgid "Directory browsing is turned off."
msgstr "La navigation dans les répertoires est désactivée."

#: .\publicapp\scanner.py:545
msgid "Public debug log file"
msgstr "Fichier de journal de débogage public"

#: .\publicapp\scanner.py:546
msgid ""
"A public debug.log file was found. These files often leak server paths, "
"database errors and sometimes secrets."
msgstr ""
"Un fichier debug.log public a été trouvé. Ces fichiers laissent souvent "
"fuiter des chemins serveur, des erreurs de base de données et parfois des "
"secrets."

#: .\publicapp\scanner.py:549
msgid "Turn off WP_DEBUG_LOG on the live site by editing wp-config.php."
msgstr ""
"Désactivez WP_DEBUG_LOG sur le site en production en modifiant wp-"
"config.php."

#: .\publicapp\scanner.py:550
msgid "Delete the existing wp-content/debug.log file."
msgstr "Supprimez le fichier wp-content/debug.log existant."

#: .\publicapp\scanner.py:551
msgid "Block access to any .log file in your .htaccess."
msgstr "Bloquez l'accès à tout fichier .log dans votre .htaccess."

#: .\publicapp\scanner.py:555
msgid "Debug log exposure"
msgstr "Exposition du journal de débogage"

#: .\publicapp\scanner.py:556
msgid "No public debug log file was found."
msgstr "Aucun fichier de journal de débogage public n'a été trouvé."

#: .\publicapp\scanner.py:561
msgid "Default files"
msgstr "Fichiers par défaut"

#: .\publicapp\scanner.py:569
msgid "Default WordPress files present"
msgstr "Fichiers WordPress par défaut présents"

#: .\publicapp\scanner.py:570
#, python-format
msgid ""
"Default install files are still reachable: %(list)s. They are harmless on "
"their own but they confirm the site runs WordPress and can hint at the "
"version."
msgstr ""
"Des fichiers d'installation par défaut sont encore accessibles : %(list)s. "
"Ils sont inoffensifs en eux-mêmes mais confirment que le site fonctionne "
"sous WordPress et peuvent indiquer la version."

#: .\publicapp\scanner.py:574
msgid "Delete files you do not need, such as license.txt and readme.html."
msgstr ""
"Supprimez les fichiers dont vous n'avez pas besoin, tels que license.txt et "
"readme.html."

#: .\publicapp\scanner.py:575
msgid "Block public access to wp-config-sample.php and other sample files."
msgstr ""
"Bloquez l'accès public à wp-config-sample.php et aux autres fichiers "
"d'exemple."

#: .\publicapp\scanner.py:579
msgid "Default WordPress files"
msgstr "Fichiers WordPress par défaut"

#: .\publicapp\scanner.py:580
msgid "No unnecessary default files were exposed."
msgstr "Aucun fichier par défaut inutile n'a été exposé."

#: .\publicapp\views.py:77
#, python-format
msgid ""
"You have used your 3 free scans. Please come back in about %(hours)s hours "
"to scan more. This limit keeps our non profit service available to everyone."
msgstr ""
"Vous avez utilisé vos 3 analyses gratuites. Revenez dans environ %(hours)s "
"heures pour en faire d'autres. Cette limite permet de garder notre service à"
" but non lucratif accessible à tous."

#: .\publicapp\views.py:99
msgid "That address could not be read."
msgstr "Cette adresse n'a pas pu être lue."

#: .\templates\adminapp\dashboard.html:4 .\templates\adminapp\dashboard.html:9
msgid "Team dashboard"
msgstr "Tableau de bord de l'équipe"

